#!/bin/sh
# Git pre-push hook: Prevents direct pushes to protected branches (main, master).
#
# Standard format read from stdin: <local ref> <local sha> <remote ref> <remote sha>

protected_branches="main master production release"

while read local_ref local_sha remote_ref remote_sha
do
    for branch in $protected_branches
    do
        if [ "$remote_ref" = "refs/heads/$branch" ]; then
            echo ""
            echo "================================================================================"
            echo " [ERROR] DIRECT PUSH TO '$branch' IS FORBIDDEN BY BRANCH GOVERNANCE POLICY"
            echo "================================================================================"
            echo " Direct pushes to protected branches are strictly disabled in this repository."
            echo ""
            echo " Correct Procedure:"
            echo "   1. Create a dedicated branch: git checkout -b feat/your-feature-name"
            echo "   2. Commit your changes:      git commit -m 'feat(...): description'"
            echo "   3. Push topic branch:        git push origin feat/your-feature-name"
            echo "   4. Open a Pull Request on GitHub for review and testing."
            echo "   5. Only the Lead Maintainer (pritpatel2412) can merge PRs into '$branch'."
            echo ""
            echo " Refer to CONTRIBUTING.md for complete details."
            echo "================================================================================"
            echo ""
            exit 1
        fi
    done
done

exit 0
